{
  "name": "steam-review-lab",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first Steam review analysis workbench.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vp check && vp build",
    "start": "tsx server/index.ts --production",
    "test": "vp test run",
    "typecheck": "vp check --no-fmt --no-lint",
    "format": "vp fmt . --write",
    "format:check": "vp fmt . --check",
    "lint": "vp lint --deny-warnings",
    "lint:fix": "vp lint --fix",
    "check": "vp check --deny-warnings"
  },
  "dependencies": {
    "@mantine/core": "9.7.4",
    "@mantine/dates": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@tabler/icons-react": "^3.35.0",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.0",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "typescript": "^5.9.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "$vite"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
