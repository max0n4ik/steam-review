{
  "name": "steam-review-lab",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first Steam review analysis workbench.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@mantine/core": "9.7.4",
    "@mantine/dates": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@tabler/icons-react": "^3.35.0",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.0",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  }
}
